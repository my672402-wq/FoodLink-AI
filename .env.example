# FoodLink AI Environment Configuration Example
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=foodlink-ai-hackathon-secret-key-2026

# Google Gemini API (Optional - application runs full deterministic fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OSRM Driving Server (Defaults to official public demo server)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT=4
